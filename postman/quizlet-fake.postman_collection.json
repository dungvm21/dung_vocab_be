				{
					"name": "01. Register learner1",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('201 Created', () => pm.expect(pm.response.code).to.eql(201));",
									"pm.test('Returns JWT + user info', () => {",
									"    const body = pm.response.json();",
									"    pm.expect(body.accessToken).to.be.a('string');",
									"    pm.expect(body.username).to.eql('learner1');",
									"    pm.expect(body.role).to.eql('ROLE_USER');",
									"});"
								]
							}
						}
					],
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"learner1\",\n  \"email\": \"learner1@example.com\",\n  \"password\": \"password123\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/register",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auth", "register"]
						}
