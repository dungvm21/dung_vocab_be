{
	"info": {
		"_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
		"name": "Quizlet Fake API",
		"description": "Complete test suite for the quizlet-fake vocabulary API.\n\n## Setup\n1. Start the app: `./gradlew bootRun` (runs on port 8081, Postgres via `docker/docker-compose.yml`)\n2. Run folder **0. Seed Sample Data** first (top to bottom) — it registers 2 users, creates decks/cards and auto-captures tokens & ids into collection variables.\n3. Then run any other folder.\n\n## Variables (auto-managed)\n- `baseUrl` — API host (default http://localhost:8081)\n- `accessToken` — learner1 JWT (captured on login)\n- `accessToken2` — learner2 JWT (captured on login)\n- `deckId` — IELTS deck (public, owned by learner1)\n- `kanjiDeckId` — Japanese deck (public, owned by learner1)\n- `privateDeckId` — private deck (owned by learner1)\n- `otherUserDeckId` — TOEIC deck (owned by learner2)\n- `cardId` — last created card in `deckId`",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{accessToken}}",
				"type": "string"
			}
		]
	},
	"variable": [
		{ "key": "baseUrl", "value": "http://localhost:8081" },
		{ "key": "accessToken", "value": "" },
		{ "key": "accessToken2", "value": "" },
		{ "key": "deckId", "value": "" },
		{ "key": "kanjiDeckId", "value": "" },
		{ "key": "privateDeckId", "value": "" },
		{ "key": "otherUserDeckId", "value": "" },
		{ "key": "cardId", "value": "" },
		{ "key": "tempDeckId", "value": "" },
		{ "key": "tempCardId", "value": "" }
	],
